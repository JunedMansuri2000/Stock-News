# Database
# SQLite (local development)
DATABASE_URL="file:./dev.db"

# PostgreSQL (production)
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NewsAPI — get your free key at https://newsapi.org/register
NEWSAPI_KEY="your_newsapi_key_here"

OPENAI_API_KEY="your_openai_key_here"

# Stock Sync (Python script reads DATABASE_URL above — no additional config needed)
# Python deps: pip install -r scripts/requirements.txt
# Run manually: python scripts/stock_sync.py
# GitHub Actions: add DATABASE_URL secret in repo Settings → Secrets → Actions
