datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma-client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model Article {
  id          String   @id @default(cuid())
  externalId  String   @unique
  title       String
  description String?
  snippet     String?
  url         String   @unique
  imageUrl    String?
  source      String?
  language    String?
  keywords    String?
  publishedAt DateTime
  createdAt   DateTime @default(now())

  @@index([publishedAt])
  @@index([source])
}

model SyncLog {
  id              String    @id @default(cuid())
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  status          String
  articlesFetched Int       @default(0)
  articlesCreated Int       @default(0)
  errorMessage    String?

  @@index([startedAt])
  @@index([status])
}

model Stock {
  id            String    @id @default(cuid())
  symbol        String    @unique
  companyName   String
  sector        String?
  currentPrice  Float?
  marketCap     Float?
  peRatio       Float?
  pbRatio       Float?
  dividendYield Float?
  dayHigh       Float?
  dayLow        Float?
  week52High    Float?
  week52Low     Float?
  volume        BigInt?
  changePercent Float?
  sparklineData Float[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  history     StockHistory[]
  indicators  TechnicalIndicator?
  opportunity StockOpportunity?

  @@index([symbol])
  @@index([changePercent])
  @@index([marketCap])
}

model StockHistory {
  id        String   @id @default(cuid())
  symbol    String
  price     Float
  volume    BigInt?
  timestamp DateTime

  stock Stock @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@unique([symbol, timestamp])
  @@index([symbol])
  @@index([timestamp])
}

model TechnicalIndicator {
  id              String   @id @default(cuid())
  symbol          String   @unique
  sma20           Float?
  sma50           Float?
  sma200          Float?
  ema20           Float?
  rsi             Float?
  macd            Float?
  macdSignal      Float?
  macdHist        Float?
  bollingerUpper  Float?
  bollingerMiddle Float?
  bollingerLower  Float?
  atr             Float?
  adx             Float?
  volumeRs        Float?
  updatedAt       DateTime @updatedAt

  stock Stock @relation(fields: [symbol], references: [symbol], onDelete: Cascade)
}

model StockOpportunity {
  id               String   @id @default(cuid())
  symbol           String   @unique
  opportunityScore Float?
  direction        String?
  riskLevel        String?
  entryZoneLow     Float?
  entryZoneHigh    Float?
  stopLoss         Float?
  target1          Float?
  target2          Float?
  holdingPeriod    String?
  momentumScore    Float?
  trendScore       Float?
  volumeScore      Float?
  volatilityScore  Float?
  technicalScore   Float?
  greeksScore      Float?
  updatedAt        DateTime @updatedAt

  stock Stock @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@index([opportunityScore])
  @@index([direction])
}

model StockSyncLog {
  id            String    @id @default(cuid())
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  status        String
  stocksUpdated Int       @default(0)
  errorMessage  String?

  @@index([startedAt])
  @@index([status])
}

model OptionChain {
  id          String   @id @default(cuid())
  symbol      String
  strike      Float
  expiry      DateTime
  callOI      Int?
  putOI       Int?
  callVolume  Int?
  putVolume   Int?
  callLTP     Float?
  putLTP      Float?
  updatedAt   DateTime @updatedAt

  greeks OptionGreeks?

  @@unique([symbol, strike, expiry])
  @@index([symbol])
  @@index([expiry])
}

model OptionGreeks {
  id                String   @id @default(cuid())
  optionChainId     String   @unique
  callDelta         Float?
  putDelta          Float?
  gamma             Float?
  theta             Float?
  vega              Float?
  impliedVolatility Float?
  updatedAt         DateTime @updatedAt

  optionChain OptionChain @relation(fields: [optionChainId], references: [id], onDelete: Cascade)
}

model AIRecommendation {
  id                  String   @id @default(cuid())
  symbol              String
  recommendation      String   // Strong Buy | Buy | Accumulate | Hold | Reduce | Sell | Strong Sell
  confidenceScore     Float    // 0–100
  overallScore        Float    // 0–100 weighted composite
  technicalScore      Float    // 0–40 (40% weight)
  sentimentScore      Float    // 0–40 (40% weight)
  momentumScore       Float    // 0–20 (20% weight)
  bullCase            String
  bearCase            String
  risks               String   // JSON array of strings
  catalysts           String   // JSON array of strings
  summary             String
  holdingPeriod       String
  positiveNewsCount   Int      @default(0)
  negativeNewsCount   Int      @default(0)
  neutralNewsCount    Int      @default(0)
  newsMomentumScore   Float    @default(0)
  newsConfidenceScore Float    @default(0)
  aiGenerated         Boolean  @default(false)
  createdAt           DateTime @default(now())

  @@index([symbol])
  @@index([recommendation])
  @@index([overallScore])
  @@index([confidenceScore])
  @@index([createdAt])
}

model AIRecommendationLog {
  id                     String    @id @default(cuid())
  startedAt              DateTime  @default(now())
  completedAt            DateTime?
  status                 String    // running | success | failed
  stocksAnalyzed         Int       @default(0)
  recommendationsCreated Int       @default(0)
  aiStocksProcessed      Int       @default(0)
  aiProvider             String?   // "ollama" | "openai" | "rule-based"
  modelName              String?   // e.g. "qwen3:8b"
  generationMs           Int?      // total wall-clock duration
  batchCount             Int?      // number of AI batch calls made
  errorMessage           String?

  @@index([startedAt])
  @@index([status])
}
