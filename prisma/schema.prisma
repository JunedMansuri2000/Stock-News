datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model Article {
  id          String   @id @default(cuid())
  externalId  String   @unique // source-prefixed id (napi_*, mc_*)
  title       String
  description String?
  snippet     String?
  url         String   @unique
  imageUrl    String?
  source      String?
  language    String?
  keywords    String?
  publishedAt DateTime
  createdAt   DateTime @default(now())

  @@index([publishedAt])
  @@index([source])
}

model SyncLog {
  id              String    @id @default(cuid())
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  status          String    // "running" | "success" | "failed"
  articlesFetched Int       @default(0)
  articlesCreated Int       @default(0)
  errorMessage    String?

  @@index([startedAt])
  @@index([status])
}
