datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma-client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model Article {
  id          String   @id @default(cuid())
  externalId  String   @unique
  title       String
  description String?
  snippet     String?
  url         String   @unique
  imageUrl    String?
  source      String?
  language    String?
  keywords    String?
  publishedAt DateTime
  createdAt   DateTime @default(now())

  @@index([publishedAt])
  @@index([source])
}

model SyncLog {
  id              String    @id @default(cuid())
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  status          String
  articlesFetched Int       @default(0)
  articlesCreated Int       @default(0)
  errorMessage    String?

  @@index([startedAt])
  @@index([status])
}

model Stock {
  id            String    @id @default(cuid())
  symbol        String    @unique
  companyName   String
  sector        String?
  currentPrice  Float?
  marketCap     Float?
  peRatio       Float?
  pbRatio       Float?
  dividendYield Float?
  dayHigh       Float?
  dayLow        Float?
  week52High    Float?
  week52Low     Float?
  volume        BigInt?
  changePercent Float?
  sparklineData Float[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  history     StockHistory[]
  indicators  TechnicalIndicator?
  opportunity StockOpportunity?

  @@index([symbol])
  @@index([changePercent])
  @@index([marketCap])
}

model StockHistory {
  id        String   @id @default(cuid())
  symbol    String
  price     Float
  volume    BigInt?
  timestamp DateTime

  stock Stock @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@unique([symbol, timestamp])
  @@index([symbol])
  @@index([timestamp])
}

model TechnicalIndicator {
  id              String   @id @default(cuid())
  symbol          String   @unique
  sma20           Float?
  sma50           Float?
  sma200          Float?
  ema20           Float?
  rsi             Float?
  macd            Float?
  macdSignal      Float?
  macdHist        Float?
  bollingerUpper  Float?
  bollingerMiddle Float?
  bollingerLower  Float?
  atr             Float?
  adx             Float?
  volumeRs        Float?
  updatedAt       DateTime @updatedAt

  stock Stock @relation(fields: [symbol], references: [symbol], onDelete: Cascade)
}

model StockOpportunity {
  id               String   @id @default(cuid())
  symbol           String   @unique
  opportunityScore Float?
  direction        String?
  riskLevel        String?
  entryZoneLow     Float?
  entryZoneHigh    Float?
  stopLoss         Float?
  target1          Float?
  target2          Float?
  holdingPeriod    String?
  momentumScore    Float?
  trendScore       Float?
  volumeScore      Float?
  volatilityScore  Float?
  technicalScore   Float?
  greeksScore      Float?
  updatedAt        DateTime @updatedAt

  stock Stock @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@index([opportunityScore])
  @@index([direction])
}

model StockSyncLog {
  id            String    @id @default(cuid())
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  status        String
  stocksUpdated Int       @default(0)
  errorMessage  String?

  @@index([startedAt])
  @@index([status])
}

model OptionChain {
  id          String   @id @default(cuid())
  symbol      String
  strike      Float
  expiry      DateTime
  callOI      Int?
  putOI       Int?
  callVolume  Int?
  putVolume   Int?
  callLTP     Float?
  putLTP      Float?
  updatedAt   DateTime @updatedAt

  greeks OptionGreeks?

  @@unique([symbol, strike, expiry])
  @@index([symbol])
  @@index([expiry])
}

model OptionGreeks {
  id                String   @id @default(cuid())
  optionChainId     String   @unique
  callDelta         Float?
  putDelta          Float?
  gamma             Float?
  theta             Float?
  vega              Float?
  impliedVolatility Float?
  updatedAt         DateTime @updatedAt

  optionChain OptionChain @relation(fields: [optionChainId], references: [id], onDelete: Cascade)
}
